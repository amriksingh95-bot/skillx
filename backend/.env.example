DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillxt?schema=public"
JWT_SECRET=your_64_char_random_hex_string_here
JWT_REFRESH_SECRET=your_64_char_random_hex_string_here
PORT=5000
API_URL=http://127.0.0.1:5000
FRONTEND_URL=https://your-deployed-frontend-url.com
NODE_ENV=development

# Gmail SMTP Integration Settings (legacy — no longer used for sending)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Resend HTTP Email API (replaces Gmail SMTP — Railway blocks SMTP ports)
RESEND_API_KEY=re_your_resend_api_key_here

# WhatsApp Alerts (CallMeBot)
ADMIN_WHATSAPP_NUMBER=91XXXXXXXXXX
ADMIN_WHATSAPP_APIKEY=your_callmebot_api_key_here

# Meta WhatsApp Cloud API Settings
WHATSAPP_ACCESS_TOKEN=your_whatsapp_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_TEMPLATE_NAME=your_approved_template_name

# Telegram Notifications
TELEGRAM_USER_ID=your_telegram_user_id
TELEGRAM_BOT_USERNAME=your_telegram_bot_username

# Gemini API (Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# UPI Payment
UPI_ID=your_upi_id@provider

# Fast2SMS (SMS/OTP gateway)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Scheduler verbose logging (set to 'true' to enable detailed scheduler logs)
SCHEDULER_VERBOSE_LOGS=false

# Supabase Storage (for file uploads — payment screenshots, ad screenshots, etc.)
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_KEY: The "service_role" key from Supabase dashboard > Settings > API
#   -> This bypasses RLS — never expose this in frontend code
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=uploads

# Referral abuse prevention — salt for hashing mobile/email before blacklist lookup
# Generate a long random value (64+ chars) for production; never commit the real value
REFERRAL_HASH_SALT=your_long_random_salt_string_here
